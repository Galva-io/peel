<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App sandbox: enforced. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound HTTPS to the App Store Server API (enforced further by our
         in-process NetworkAllowlist). -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- User-selected file access for importing .p8 keys. Read-only because
         we never modify the source file. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Hardened runtime defaults. We do NOT enable any
         disable-library-validation or allow-unsigned-executable-memory
         entitlements. -->

    <!-- Opt the sandboxed app into the Data Protection keychain. The single
         entry here exists not to share items with other apps — Peel ships
         alone — but because macOS requires `keychain-access-groups` to be
         declared before `kSecUseDataProtectionKeychain = true` queries are
         accepted. With this in place, KeychainStore stops touching the
         user's login keychain entirely; items live in the iOS-style
         data-protection keychain, bound to the app's signed identity, and
         macOS never prompts the user for access. -->
    <key>keychain-access-groups</key>
    <array>
        <string>$(AppIdentifierPrefix)io.galva.peel</string>
    </array>
</dict>
</plist>
