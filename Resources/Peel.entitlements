<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App sandbox: enforced. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Outbound HTTPS to the App Store Server API (enforced further by our
         in-process NetworkAllowlist). -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- User-selected file access for importing .p8 keys. Read-only because
         we never modify the source file. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Hardened runtime defaults. We do NOT enable any
         disable-library-validation or allow-unsigned-executable-memory
         entitlements. -->

    <!-- We deliberately do NOT request `keychain-access-groups` even though
         the data-protection keychain would give us iOS-style no-prompt
         behavior. That entitlement is on the AMFI "managed" list, so AMFI
         rejects the binary at launch ("No matching profile found") unless
         a Developer ID provisioning profile is embedded in the bundle —
         not just notarization. For a signed Developer ID app accessing
         items it created itself, the login keychain doesn't prompt in
         practice, so the simpler config wins. If we ever need true
         no-prompt behavior we'll add the profile via developer.apple.com
         and embed it in CI; `KeychainStore`'s runtime probe is already in
         place to opt into the data-protection keychain when available. -->
</dict>
</plist>
